# Copy this file to ".env" (which git ignores) and fill in the values. Docker Compose reads ".env" by itself.
# Only needed for the full system:  docker compose --profile app up -d --build
# Every value below has a development default in docker-compose.yml, EXCEPT JWT_KEY.

# REQUIRED. Signs the login tokens: at least 32 characters, random, secret. Anyone who knows it can forge a login.
# Make one with:  openssl rand -base64 48
JWT_KEY=

# The port of the web server on your machine (http://localhost:8080 by default).
# WEB_PORT=8080

# Database and storage credentials (the defaults are for development only; change them for anything else).
# POSTGRES_USER=inknote
# POSTGRES_PASSWORD=inknote_dev
# POSTGRES_DB=inknote
# MINIO_ROOT_USER=inknote
# MINIO_ROOT_PASSWORD=inknote_dev_secret

# The address the BROWSER uses to download attachments (presigned links). Change it when the storage is not on localhost.
# STORAGE_PUBLIC_URL=http://localhost:9000
